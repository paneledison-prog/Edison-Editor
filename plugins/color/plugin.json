{
 "api": 1,
 "id": "color",
 "name": "Color and look",
 "version": "1.0.0",
 "license": "MIT",
 "summary": "Built-in colour grading and look effects: correction, wheels, curves, qualifier, windows, blur, light, distortion, keyer, film look.",
 "effects": [
  {
   "id": "lumetri",
   "summary": "All-in-one correction: exposure, contrast, highlights, shadows, whites, blacks, white balance, saturation, vibrance, sharpen.",
   "params": {
    "exposure": {
     "type": "number",
     "default": 0,
     "min": -4,
     "max": 4,
     "desc": "stops; assumes gamma 2.2"
    },
    "contrast": {
     "type": "number",
     "default": 0,
     "min": -100,
     "max": 100,
     "desc": "contrast around mid grey"
    },
    "highlights": {
     "type": "number",
     "default": 0,
     "min": -100,
     "max": 100,
     "desc": "-100 darkens highlights"
    },
    "shadows": {
     "type": "number",
     "default": 0,
     "min": -100,
     "max": 100,
     "desc": "+100 lifts shadows"
    },
    "whites": {
     "type": "number",
     "default": 0,
     "min": -100,
     "max": 100,
     "desc": "white point"
    },
    "blacks": {
     "type": "number",
     "default": 0,
     "min": -100,
     "max": 100,
     "desc": "black point; + lifts"
    },
    "temperature": {
     "type": "number",
     "default": 0,
     "min": -100,
     "max": 100,
     "desc": "-100 cool, +100 warm"
    },
    "tint": {
     "type": "number",
     "default": 0,
     "min": -100,
     "max": 100,
     "desc": "-100 green, +100 magenta"
    },
    "saturation": {
     "type": "number",
     "default": 0,
     "min": -100,
     "max": 100,
     "desc": "-100 is monochrome"
    },
    "vibrance": {
     "type": "number",
     "default": 0,
     "min": -100,
     "max": 100,
     "desc": "saturates muted colours more"
    },
    "sharpen": {
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 3,
     "desc": "unsharp amount"
    }
   },
   "graph": "[in]format=gbrp,lutrgb=r='0*st(1,pow(clip(pow((val/maxval),2.2)*pow(2,{exposure}),0,1),1/2.2))+0*st(1,clip(ld(1)*(1+0.15*{temperature}/100),0,1))+0*st(1,clip((ld(1)-0.5)*(1+{contrast}/100)+0.5,0,1))+0*st(1,clip(ld(1)+1.7*{shadows}/100*ld(1)*pow(1-ld(1),2)+1.7*{highlights}/100*pow(ld(1),2)*(1-ld(1)),0,1))+0*st(1,clip(ld(1)+0.12*{blacks}/100*pow(1-ld(1),3)+0.12*{whites}/100*pow(ld(1),3),0,1))+ld(1)*maxval':g='0*st(1,pow(clip(pow((val/maxval),2.2)*pow(2,{exposure}),0,1),1/2.2))+0*st(1,clip(ld(1)*(1-0.1*{tint}/100),0,1))+0*st(1,clip((ld(1)-0.5)*(1+{contrast}/100)+0.5,0,1))+0*st(1,clip(ld(1)+1.7*{shadows}/100*ld(1)*pow(1-ld(1),2)+1.7*{highlights}/100*pow(ld(1),2)*(1-ld(1)),0,1))+0*st(1,clip(ld(1)+0.12*{blacks}/100*pow(1-ld(1),3)+0.12*{whites}/100*pow(ld(1),3),0,1))+ld(1)*maxval':b='0*st(1,pow(clip(pow((val/maxval),2.2)*pow(2,{exposure}),0,1),1/2.2))+0*st(1,clip(ld(1)*(1-0.15*{temperature}/100),0,1))+0*st(1,clip((ld(1)-0.5)*(1+{contrast}/100)+0.5,0,1))+0*st(1,clip(ld(1)+1.7*{shadows}/100*ld(1)*pow(1-ld(1),2)+1.7*{highlights}/100*pow(ld(1),2)*(1-ld(1)),0,1))+0*st(1,clip(ld(1)+0.12*{blacks}/100*pow(1-ld(1),3)+0.12*{whites}/100*pow(ld(1),3),0,1))+ld(1)*maxval',eq=saturation=(1+{saturation}/100),vibrance=intensity=({vibrance}/100*2),unsharp=5:5:{sharpen}:5:5:0,format=yuv420p[out]",
   "cost": "light"
  },
  {
   "id": "primary",
   "summary": "Primary wheels: Lift, Gamma, Gain, Offset, master and per channel.",
   "params": {
    "liftM": {
     "type": "number",
     "default": 0,
     "min": -0.5,
     "max": 0.5,
     "desc": "lift, all channels"
    },
    "liftR": {
     "type": "number",
     "default": 0,
     "min": -0.5,
     "max": 0.5,
     "desc": "lift, red"
    },
    "liftG": {
     "type": "number",
     "default": 0,
     "min": -0.5,
     "max": 0.5,
     "desc": "lift, green"
    },
    "liftB": {
     "type": "number",
     "default": 0,
     "min": -0.5,
     "max": 0.5,
     "desc": "lift, blue"
    },
    "gammaM": {
     "type": "number",
     "default": 1,
     "min": 0.2,
     "max": 3,
     "desc": "gamma, all channels"
    },
    "gammaR": {
     "type": "number",
     "default": 1,
     "min": 0.2,
     "max": 3,
     "desc": "gamma, red"
    },
    "gammaG": {
     "type": "number",
     "default": 1,
     "min": 0.2,
     "max": 3,
     "desc": "gamma, green"
    },
    "gammaB": {
     "type": "number",
     "default": 1,
     "min": 0.2,
     "max": 3,
     "desc": "gamma, blue"
    },
    "gainM": {
     "type": "number",
     "default": 1,
     "min": 0,
     "max": 4,
     "desc": "gain, all channels"
    },
    "gainR": {
     "type": "number",
     "default": 1,
     "min": 0,
     "max": 4,
     "desc": "gain, red"
    },
    "gainG": {
     "type": "number",
     "default": 1,
     "min": 0,
     "max": 4,
     "desc": "gain, green"
    },
    "gainB": {
     "type": "number",
     "default": 1,
     "min": 0,
     "max": 4,
     "desc": "gain, blue"
    },
    "offsetM": {
     "type": "number",
     "default": 0,
     "min": -0.5,
     "max": 0.5,
     "desc": "offset, all channels"
    },
    "offsetR": {
     "type": "number",
     "default": 0,
     "min": -0.5,
     "max": 0.5,
     "desc": "offset, red"
    },
    "offsetG": {
     "type": "number",
     "default": 0,
     "min": -0.5,
     "max": 0.5,
     "desc": "offset, green"
    },
    "offsetB": {
     "type": "number",
     "default": 0,
     "min": -0.5,
     "max": 0.5,
     "desc": "offset, blue"
    }
   },
   "graph": "[in]format=gbrp,lutrgb=r='clip(pow(clip(((val/maxval)+({liftM}+{liftR})*(1-(val/maxval)))*({gainM}*{gainR})+({offsetM}+{offsetR}),0,1),1/({gammaM}*{gammaR})),0,1)*maxval':g='clip(pow(clip(((val/maxval)+({liftM}+{liftG})*(1-(val/maxval)))*({gainM}*{gainG})+({offsetM}+{offsetG}),0,1),1/({gammaM}*{gammaG})),0,1)*maxval':b='clip(pow(clip(((val/maxval)+({liftM}+{liftB})*(1-(val/maxval)))*({gainM}*{gainB})+({offsetM}+{offsetB}),0,1),1/({gammaM}*{gammaB})),0,1)*maxval',format=yuv420p[out]",
   "cost": "light"
  },
  {
   "id": "zones",
   "summary": "HDR-style tonal zones: exposure in stops for deep shadows, shadows, midtones, lights, and speculars.",
   "params": {
    "deep": {
     "type": "number",
     "default": 0,
     "min": -3,
     "max": 3,
     "desc": "deep shadows, stops"
    },
    "shadows": {
     "type": "number",
     "default": 0,
     "min": -3,
     "max": 3,
     "desc": "shadows, stops"
    },
    "mids": {
     "type": "number",
     "default": 0,
     "min": -3,
     "max": 3,
     "desc": "midtones, stops"
    },
    "lights": {
     "type": "number",
     "default": 0,
     "min": -3,
     "max": 3,
     "desc": "lights, stops"
    },
    "spec": {
     "type": "number",
     "default": 0,
     "min": -3,
     "max": 3,
     "desc": "specular highlights, stops"
    }
   },
   "graph": "[in]format=gbrp,lutrgb=r='clip((val/maxval)*pow(2,{deep}*exp(-pow(((val/maxval)-0.04)/0.1,2))+{shadows}*exp(-pow(((val/maxval)-0.22)/0.12,2))+{mids}*exp(-pow(((val/maxval)-0.5)/0.16,2))+{lights}*exp(-pow(((val/maxval)-0.78)/0.12,2))+{spec}*exp(-pow(((val/maxval)-0.96)/0.08,2))),0,1)*maxval':g='clip((val/maxval)*pow(2,{deep}*exp(-pow(((val/maxval)-0.04)/0.1,2))+{shadows}*exp(-pow(((val/maxval)-0.22)/0.12,2))+{mids}*exp(-pow(((val/maxval)-0.5)/0.16,2))+{lights}*exp(-pow(((val/maxval)-0.78)/0.12,2))+{spec}*exp(-pow(((val/maxval)-0.96)/0.08,2))),0,1)*maxval':b='clip((val/maxval)*pow(2,{deep}*exp(-pow(((val/maxval)-0.04)/0.1,2))+{shadows}*exp(-pow(((val/maxval)-0.22)/0.12,2))+{mids}*exp(-pow(((val/maxval)-0.5)/0.16,2))+{lights}*exp(-pow(((val/maxval)-0.78)/0.12,2))+{spec}*exp(-pow(((val/maxval)-0.96)/0.08,2))),0,1)*maxval',format=yuv420p[out]",
   "cost": "light"
  },
  {
   "id": "curves",
   "summary": "Curves: master, red, green, blue, each a list of x/y points.",
   "params": {
    "master": {
     "type": "points",
     "default": "0/0 1/1",
     "desc": "master curve"
    },
    "red": {
     "type": "points",
     "default": "0/0 1/1",
     "desc": "red curve"
    },
    "green": {
     "type": "points",
     "default": "0/0 1/1",
     "desc": "green curve"
    },
    "blue": {
     "type": "points",
     "default": "0/0 1/1",
     "desc": "blue curve"
    }
   },
   "graph": "[in]format=gbrp,curves=master='{master}':red='{red}':green='{green}':blue='{blue}',format=yuv420p[out]",
   "cost": "light"
  },
  {
   "id": "hue-sat",
   "summary": "Hue, saturation, and intensity shifts for one colour family or all: a targeted Hue vs Hue / Sat / Lum.",
   "params": {
    "target": {
     "type": "enum",
     "default": "a",
     "values": [
      "a",
      "r",
      "y",
      "g",
      "c",
      "b",
      "m"
     ],
     "desc": "a all, r red, y yellow, g green, c cyan, b blue, m magenta"
    },
    "hue": {
     "type": "number",
     "default": 0,
     "min": -180,
     "max": 180,
     "desc": "degrees"
    },
    "saturation": {
     "type": "number",
     "default": 0,
     "min": -1,
     "max": 1,
     "desc": "-1 grey, +1 doubled"
    },
    "intensity": {
     "type": "number",
     "default": 0,
     "min": -1,
     "max": 1,
     "desc": "luma shift"
    },
    "strength": {
     "type": "number",
     "default": 1,
     "min": 0,
     "max": 100,
     "desc": "how strongly the family is selected"
    }
   },
   "graph": "[in]format=gbrp,huesaturation=hue={hue}:saturation={saturation}:intensity={intensity}:colors={target}:strength={strength},format=yuv420p[out]",
   "cost": "light"
  },
  {
   "id": "qualifier",
   "summary": "Qualifier: select a colour range (hue, saturation, value) with soft edges and grade only that.",
   "params": {
    "hue": {
     "type": "number",
     "default": 120,
     "min": 0,
     "max": 360,
     "desc": "centre of the colour range, degrees (0 red, 120 green, 240 blue)"
    },
    "hueWidth": {
     "type": "number",
     "default": 30,
     "min": 1,
     "max": 180,
     "desc": "half-width of the range, degrees"
    },
    "satMin": {
     "type": "number",
     "default": 0.3,
     "min": 0,
     "max": 1,
     "desc": "lowest saturation selected"
    },
    "satMax": {
     "type": "number",
     "default": 1,
     "min": 0,
     "max": 1,
     "desc": "highest saturation selected"
    },
    "valMin": {
     "type": "number",
     "default": 0.15,
     "min": 0,
     "max": 1,
     "desc": "darkest value selected"
    },
    "valMax": {
     "type": "number",
     "default": 1,
     "min": 0,
     "max": 1,
     "desc": "brightest value selected"
    },
    "edge": {
     "type": "number",
     "default": 0.25,
     "min": 0,
     "max": 1,
     "desc": "softness of the selection edge"
    },
    "soften": {
     "type": "number",
     "default": 1.5,
     "min": 0,
     "max": 20,
     "desc": "blur of the selection"
    },
    "invert": {
     "type": "boolean",
     "default": false,
     "desc": "grade everything except the range"
    },
    "shift": {
     "type": "number",
     "default": 0,
     "min": -180,
     "max": 180,
     "desc": "hue shift of the selection, degrees"
    },
    "sat": {
     "type": "number",
     "default": 0,
     "min": -1,
     "max": 1,
     "desc": "saturation change"
    },
    "gamma": {
     "type": "number",
     "default": 1,
     "min": 0.3,
     "max": 3,
     "desc": "gamma of the selection"
    },
    "warm": {
     "type": "number",
     "default": 0,
     "min": -100,
     "max": 100,
     "desc": "warmth of the selection"
    }
   },
   "graph": "[in]format=gbrp,split=3[o][g][k];[g]huesaturation=hue={shift}:saturation={sat},eq=gamma={gamma},lutrgb=r='clip(val*(1+0.15*{warm}/100),0,maxval)':b='clip(val*(1-0.15*{warm}/100),0,maxval)'[adj];[k]scale=192:108,geq=r='0*st(1,r(X,Y)/255)+0*st(2,g(X,Y)/255)+0*st(3,b(X,Y)/255)+0*st(4,max(ld(1),max(ld(2),ld(3))))+0*st(5,min(ld(1),min(ld(2),ld(3))))+0*st(6,if(gt(ld(4),0.0001),(ld(4)-ld(5))/ld(4),0))+0*st(7,mod(atan2(sqrt(3)*(ld(2)-ld(3)),2*ld(1)-ld(2)-ld(3))*180/PI+360,360))+0*st(8,abs(mod(ld(7)-{hue}+540,360)-180))+255*abs({invert}-clip(1-(ld(8)-{hueWidth})/({hueWidth}*{edge}+0.01),0,1)*clip(1-({satMin}-ld(6))/({edge}*0.3+0.01),0,1)*clip(1-(ld(6)-{satMax})/({edge}*0.3+0.01),0,1)*clip(1-({valMin}-ld(4))/({edge}*0.3+0.01),0,1)*clip(1-(ld(4)-{valMax})/({edge}*0.3+0.01),0,1))':g='0*st(1,r(X,Y)/255)+0*st(2,g(X,Y)/255)+0*st(3,b(X,Y)/255)+0*st(4,max(ld(1),max(ld(2),ld(3))))+0*st(5,min(ld(1),min(ld(2),ld(3))))+0*st(6,if(gt(ld(4),0.0001),(ld(4)-ld(5))/ld(4),0))+0*st(7,mod(atan2(sqrt(3)*(ld(2)-ld(3)),2*ld(1)-ld(2)-ld(3))*180/PI+360,360))+0*st(8,abs(mod(ld(7)-{hue}+540,360)-180))+255*abs({invert}-clip(1-(ld(8)-{hueWidth})/({hueWidth}*{edge}+0.01),0,1)*clip(1-({satMin}-ld(6))/({edge}*0.3+0.01),0,1)*clip(1-(ld(6)-{satMax})/({edge}*0.3+0.01),0,1)*clip(1-({valMin}-ld(4))/({edge}*0.3+0.01),0,1)*clip(1-(ld(4)-{valMax})/({edge}*0.3+0.01),0,1))':b='0*st(1,r(X,Y)/255)+0*st(2,g(X,Y)/255)+0*st(3,b(X,Y)/255)+0*st(4,max(ld(1),max(ld(2),ld(3))))+0*st(5,min(ld(1),min(ld(2),ld(3))))+0*st(6,if(gt(ld(4),0.0001),(ld(4)-ld(5))/ld(4),0))+0*st(7,mod(atan2(sqrt(3)*(ld(2)-ld(3)),2*ld(1)-ld(2)-ld(3))*180/PI+360,360))+0*st(8,abs(mod(ld(7)-{hue}+540,360)-180))+255*abs({invert}-clip(1-(ld(8)-{hueWidth})/({hueWidth}*{edge}+0.01),0,1)*clip(1-({satMin}-ld(6))/({edge}*0.3+0.01),0,1)*clip(1-(ld(6)-{satMax})/({edge}*0.3+0.01),0,1)*clip(1-({valMin}-ld(4))/({edge}*0.3+0.01),0,1)*clip(1-(ld(4)-{valMax})/({edge}*0.3+0.01),0,1))',gblur=sigma={soften},scale={W}:{H},format=gbrp[m];[o][adj][m]maskedmerge,format=yuv420p[out]",
   "cost": "medium"
  },
  {
   "id": "window",
   "summary": "Power window: grade inside (or outside) an ellipse or rounded rectangle with a soft edge. Static; it does not track.",
   "params": {
    "cx": {
     "type": "number",
     "default": 0.5,
     "min": 0,
     "max": 1,
     "desc": "centre x, fraction"
    },
    "cy": {
     "type": "number",
     "default": 0.5,
     "min": 0,
     "max": 1,
     "desc": "centre y, fraction"
    },
    "w": {
     "type": "number",
     "default": 0.4,
     "min": 0.02,
     "max": 1,
     "desc": "width, fraction"
    },
    "h": {
     "type": "number",
     "default": 0.4,
     "min": 0.02,
     "max": 1,
     "desc": "height, fraction"
    },
    "corner": {
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 1,
     "desc": "0 ellipse, 1 near-rectangle"
    },
    "feather": {
     "type": "number",
     "default": 0.25,
     "min": 0.01,
     "max": 1,
     "desc": "edge softness"
    },
    "invert": {
     "type": "boolean",
     "default": false,
     "desc": "grade outside the window"
    },
    "exposure": {
     "type": "number",
     "default": 0,
     "min": -3,
     "max": 3,
     "desc": "stops inside"
    },
    "saturation": {
     "type": "number",
     "default": 0,
     "min": -1,
     "max": 1,
     "desc": "saturation change inside"
    },
    "warm": {
     "type": "number",
     "default": 0,
     "min": -100,
     "max": 100,
     "desc": "warmth inside"
    },
    "blur": {
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 40,
     "desc": "blur inside (privacy or focus)"
    }
   },
   "graph": "[in]format=gbrp,split=3[o][g][k];[g]lutrgb=r='clip(val*pow(2,{exposure})*(1+0.15*{warm}/100),0,maxval)':g='clip(val*pow(2,{exposure}),0,maxval)':b='clip(val*pow(2,{exposure})*(1-0.15*{warm}/100),0,maxval)',eq=saturation=(1+{saturation}),gblur=sigma={blur}[adj];[k]scale=192:108,geq=r='255*abs({invert}-clip((1-pow(pow(abs(X/W-{cx})/({w}/2),2+18*{corner})+pow(abs(Y/H-{cy})/({h}/2),2+18*{corner}),1/(2+18*{corner})))/{feather},0,1))':g='255*abs({invert}-clip((1-pow(pow(abs(X/W-{cx})/({w}/2),2+18*{corner})+pow(abs(Y/H-{cy})/({h}/2),2+18*{corner}),1/(2+18*{corner})))/{feather},0,1))':b='255*abs({invert}-clip((1-pow(pow(abs(X/W-{cx})/({w}/2),2+18*{corner})+pow(abs(Y/H-{cy})/({h}/2),2+18*{corner}),1/(2+18*{corner})))/{feather},0,1))',scale={W}:{H},format=gbrp[m];[o][adj][m]maskedmerge,format=yuv420p[out]",
   "cost": "medium"
  },
  {
   "id": "tritone",
   "summary": "Tint / tritone: map brightness onto two or three colours for duotone, sepia, or monochrome looks.",
   "params": {
    "shadow": {
     "type": "color",
     "default": "#101830",
     "desc": "colour of the shadows"
    },
    "mid": {
     "type": "color",
     "default": "#806a58",
     "desc": "colour of the midtones"
    },
    "high": {
     "type": "color",
     "default": "#f4e6c8",
     "desc": "colour of the highlights"
    },
    "mix": {
     "type": "number",
     "default": 1,
     "min": 0,
     "max": 1,
     "desc": "how much of the effect to apply"
    }
   },
   "graph": "[in]format=gbrp,split=2[o][t];[t]format=gray,format=gbrp,lutrgb=r='(if(lt((val/maxval),0.5),{shadow.r}+({mid.r}-{shadow.r})*(val/maxval)*2,{mid.r}+({high.r}-{mid.r})*((val/maxval)-0.5)*2))*maxval':g='(if(lt((val/maxval),0.5),{shadow.g}+({mid.g}-{shadow.g})*(val/maxval)*2,{mid.g}+({high.g}-{mid.g})*((val/maxval)-0.5)*2))*maxval':b='(if(lt((val/maxval),0.5),{shadow.b}+({mid.b}-{shadow.b})*(val/maxval)*2,{mid.b}+({high.b}-{mid.b})*((val/maxval)-0.5)*2))*maxval'[tm];[tm][o]blend=all_mode=normal:all_opacity={mix},format=yuv420p[out]",
   "cost": "light"
  },
  {
   "id": "colorspace",
   "summary": "Convert between colour spaces (Rec.601, Rec.709, Rec.2020) so footage from different sources matches. Not a camera log transform.",
   "params": {
    "from": {
     "type": "enum",
     "default": "bt709",
     "values": [
      "bt709",
      "bt2020",
      "bt601-6-625",
      "bt601-6-525"
     ],
     "desc": "colour space of the source"
    },
